		name 'Spk Master Volume'
		value 391
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 391'
			dbmin -10375
			dbmax -600
			dbvalue.0 -600
		}
	}
	control.2 {
		iface MIXER
		name 'Spk Speaker Volume'
		value.0 415
		value.1 415
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 415'
			dbmin -10375
			dbmax 0
			dbvalue.0 0
			dbvalue.1 0
		}
	}
	control.3 {
		iface MIXER
		name 'Spk Speaker Switch'
		value.0 true
		value.1 true
		comment {
			access 'read write'
			type BOOLEAN
			count 2
		}
	}
	control.4 {
		iface MIXER
		name 'Mic0 PGA Capture Volume'
		value.0 35
		value.1 35
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 80'
			dbmin 0
			dbmax 4000
			dbvalue.0 1750
			dbvalue.1 1750
		}
	}
	control.5 {
