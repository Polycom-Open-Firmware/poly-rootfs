# Baked ALSA mixer defaults, one section per board card; alsa-restore
# applies whichever card is present and ignores the rest.
# - tas5751audio: the TC8 speaker amp (unmuted, full-scale master).
# - keplerc60: the Trio C60 conference card — speaker path plus the mic
#   array's validated capture chain (IN_1 routing on all three ADCs,
#   PGA 35, ADC volume 90% — levels ear-approved against acoustic
#   loopback on hardware).
state.tas5751audio {
	control.1 {
		iface MIXER
		name 'Master Volume'
		value 409
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 511'
			dbmin -10375
			dbmax 2400
			dbvalue.0 -150
		}
	}
	control.2 {
		iface MIXER
		name 'Speaker Volume'
		value.0 383
		value.1 383
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 511'
			dbmin -10375
			dbmax 2400
			dbvalue.0 -800
			dbvalue.1 -800
		}
	}
	control.3 {
		iface MIXER
		name 'Speaker Switch'
		value.0 true
		value.1 true
		comment {
			access 'read write'
			type BOOLEAN
			count 2
		}
	}
	control.4 {
		iface MIXER
		name 'CH1 Mixer Volume'
		value.0 128
		value.1 128
		comment {
			access 'read write'
			type INTEGER
			count 2
			range '0 - 128'
		}
	}
	control.5 {
		iface MIXER
		name 'CH2 Mixer Volume'
		value.0 128
		value.1 128
		comment {
			access 'read write'
			type INTEGER
			count 2
